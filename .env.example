# ============================================================
# SGVA Offer Scraper - Configuración
# ============================================================
# Renombra este archivo a .env y completa tus datos.
# NUNCA subas tu .env a GitHub (contiene contraseñas reales).
# ============================================================

# --- Credenciales SGVA (portal SENA) ---
SGVA_USERNAME=TU_NUMERO_DOCUMENTO
SGVA_PASSWORD=TU_CONTRASENA_SGVA

# --- API de Groq Cloud (gratuita, para estructurar ofertas con IA) ---
# Obtén tu API key en: https://console.groq.com/keys
GROQ_API_KEY=TU_API_KEY_DE_GROQ

# --- (Opcional) Credenciales ElEmpleo / LinkedIn ---
ELEMPLEO_USERNAME=
ELEMPLEO_PASSWORD=
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# --- (Opcional) Credenciales Gmail para envío de correos ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
